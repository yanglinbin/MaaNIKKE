{
	"name": "MaaNIKKE",
	"interface_version": "2",
	"version": "",
	"custom_title": "MaaNIKKE",
	"url": "https://github.com/yanglinbin/MaaNIKKE",

	"controller": [
		{
			"name": "桌面端",
			"type": "Win32",
			"win32": {
				"class_regex": "UnityWndClass*",
				"window_regex": "NIKKE",
				"input": 1,
				"screencap": 8
			}
		}
	],
	"resource": [
		{
			"name": "国际服",
			"path": ["{PROJECT_DIR}/resource/base"]
		}
	],
	"agent": {
		"child_exec": "./python/python.exe",
		"child_args": ["-u", "./agent/main.py"]
	},
	"task": [
		{
			"name": "方舟",
			"entry": "方舟",
			"default_check": true,
			"option": ["拦截战", "模拟室", "无限之塔", "竞技场"]
		},
		{
			"name": "妮姬咨询",
			"entry": "妮姬咨询",
			"default_check": true,
			"option": ["妮姬咨询次数上限"]
		},
		{
			"name": "百货商店",
			"entry": "百货商店",
			"default_check": true,
			"option": ["普通商店", "竞技场商店"]
		},
		{
			"name": "付费商店",
			"default_check": true,
			"entry": "付费商店"
		},
		{
			"name": "前哨基地",
			"entry": "前哨基地",
			"default_check": true,
			"option": ["派遣公告栏"]
		},
		{
			"name": "活动",
			"entry": "活动",
			"default_check": false,
			"option": ["大活动", "小活动"]
		},
		{
			"name": "奖励领取",
			"entry": "奖励领取",
			"default_check": true,
			"option": ["友情点赠送", "防御基地奖励领取", "邮箱领取", "任务领取", "通行证领取"]
		}
	],
	"option": {
		"妮姬咨询次数上限": {
			"cases": [
				{
					"name": "5",
					"pipeline_override": {
						"妮姬咨询次数到达上限": {
							"recognition": {
								"type": "OCR",
								"param": {
									"expected": ["^0/5$"]
								}
							}
						}
					}
				},
				{
					"name": "6",
					"pipeline_override": {
						"妮姬咨询次数到达上限": {
							"recognition": {
								"type": "OCR",
